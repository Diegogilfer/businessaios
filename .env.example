# ============================================================
# BusinessAIOS v1.3.0 — .env completo
# Copia este archivo: cp .env.example .env
# Luego edita con tus credenciales reales
# NUNCA subas tu .env a git (ya está en .gitignore)
# ============================================================

# ── APP ────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# ── ACCESO Y SEGURIDAD ─────────────────────────────────────
# Genera tu clave con: curl http://localhost:8000/auth/generate-key
# Formato: BAIOS-XXXX-XXXX-XXXX
ACCESS_KEY=BAIOS-TU-CLAVE-AQUI
RECOVERY_EMAIL=diegogilfer.93@gmail.com
# Genera uno fuerte: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esto-en-produccion-con-valor-aleatorio
JWT_EXPIRY_HOURS=24

# ── DATABASE (Supabase) ────────────────────────────────────
# Panel: supabase.com → tu proyecto → Settings → API
# IMPORTANTE: con RLS habilitado, el backend usa la SERVICE_ROLE key
# (la anon/public NO puede leer nada). Mantén esta key SOLO en el servidor.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-service-role-key

# ── AI PROVIDERS ───────────────────────────────────────────
# Activa UNO. DEFAULT_LLM_PROVIDER decide cuál usa el sistema.
DEFAULT_LLM_PROVIDER=deepseek

# DeepSeek (recomendado — económico y potente)
# Obtén tu key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-...
# V4 Flash: rápido y barato | V4 Pro: razonamiento avanzado
# IMPORTANTE: deepseek-chat deprecado el 24-Jul-2026
DEFAULT_MODEL=deepseek-v4-flash

# Gemini (alternativa)
# Obtén tu key: https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── EMAIL / RECUPERACIÓN (opcional pero recomendado) ───────
# Para que la recuperación de contraseña funcione por email
# Usa una "Contraseña de aplicación" de Google (no tu contraseña normal)
# Google: Cuenta → Seguridad → Verificación en 2 pasos → Contraseñas de aplicación
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=diegogilfer.93@gmail.com
SMTP_PASS=tu-contrasena-de-aplicacion-gmail

# ── AMAZON SP-API (Arbitrage Engine) ──────────────────────
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=
AMAZON_REGION=us-east-1
AMAZON_SELLER_ID=

# ── ALIEXPRESS API ────────────────────────────────────────
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=

# ── WEB SEARCH (opcional) ─────────────────────────────────
SERP_API_KEY=
TAVILY_API_KEY=

# ── STRIPE (SaaS billing) ─────────────────────────────────
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# IDs de precios de Stripe (crear en dashboard.stripe.com → Products)
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...

# ── CORS ──────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000

# ── LOGGING ───────────────────────────────────────────────
LOG_LEVEL=INFO

# ── CANALES ────────────────────────────────────────────────
# WhatsApp Business (Meta Developers)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=businessaios_verify
WHATSAPP_APP_SECRET=

# Telegram Bot (@BotFather)
TELEGRAM_BOT_TOKEN=

# ── OBSERVABILIDAD ─────────────────────────────────────────
# Sentry (sentry.io → nuevo proyecto → DSN)
SENTRY_DSN=

# Posthog (posthog.com → API key)
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# Slack (slack.com/apps → Incoming Webhooks)
SLACK_WEBHOOK_URL=
